#!/usr/bin/env sh
# ----------------------------------------------------------------------------
# Maven wrapper script
# ----------------------------------------------------------------------------
set -e
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MVNW_REPO="${SCRIPT_DIR}/.mvn/wrapper"
java -cp "${MVNW_REPO}/maven-wrapper.jar" org.apache.maven.wrapper.MavenWrapperMain "$@"
