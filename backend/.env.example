# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/knowbridge_ai_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Server Port
PORT=8080

# JWT Security (Must be at least 256 bits / 32 bytes hex or base64)
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRATION=86400000

# File Upload Directory
FILE_UPLOAD_DIR=uploads
